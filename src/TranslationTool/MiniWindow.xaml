<Window x:Class="TranslationTool.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线翻译 · Mini"
        Width="420" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ContentRendered="OnMiniContentRendered"
        PreviewKeyDown="OnMiniPreviewKeyDown">

    <Border x:Name="MiniRoot" CornerRadius="14" Background="#FBFCFE" BorderBrush="#DCE3F0" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#0B1B3A" />
        </Border.Effect>

        <StackPanel Margin="14,12,14,14">
            <!-- 标题行：可拖动 -->
            <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#2BB673" VerticalAlignment="Center" />
                    <TextBlock x:Name="MiniTitle" Text="离线翻译 · Mini" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="#17203D" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PinButton" Content="置顶" Click="OnPinClick" FontSize="11.5" Cursor="Hand"
                            Foreground="#2F6FED" FontWeight="SemiBold" Background="Transparent" BorderThickness="0"
                            Padding="6,2" ToolTip="切换窗口置顶" />
                    <Button x:Name="RestoreButton" Content="⤢ 主窗口" Click="OnRestoreClick" FontSize="11.5" Cursor="Hand"
                            Foreground="#7A849B" Background="Transparent" BorderThickness="0" Padding="6,2"
                            ToolTip="返回完整界面" />
                    <Button x:Name="CloseButton" Content="✕" Click="OnCloseClick" FontSize="11.5" Cursor="Hand"
                            Foreground="#7A849B" Background="Transparent" BorderThickness="0" Padding="8,2"
                            ToolTip="关闭迷你窗口，留在托盘（单击托盘图标可再次打开）" />
                </StackPanel>
            </Grid>

            <!-- 输入框（置顶显示） -->
            <Border x:Name="InputCard" Background="White" CornerRadius="10" Padding="12,10"
                    BorderBrush="#E6EAF3" BorderThickness="1">
                <Grid>
                    <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                             AcceptsReturn="True" TextWrapping="Wrap" FontSize="14"
                             MinHeight="60" MaxHeight="150" CaretBrush="#2F6FED"
                             VerticalScrollBarVisibility="Auto" TextChanged="OnInputChanged" />
                    <TextBlock x:Name="Placeholder" Text="输入文字，停顿后自动翻译…"
                               FontSize="14" Foreground="#A8B0C2" TextWrapping="Wrap"
                               IsHitTestVisible="False" Margin="1,1,0,0" />
                </Grid>
            </Border>

            <!-- 译文：有结果时向下展开 -->
            <Border x:Name="OutputCard" Background="White" CornerRadius="10" Padding="12,10" Margin="0,8,0,0"
                    BorderBrush="#E6EAF3" BorderThickness="1" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="OutputLabel" Text="译文" FontSize="11.5" Foreground="#7A849B" VerticalAlignment="Center" />
                        <Button x:Name="CopyButton" Content="复制" Click="OnCopyClick" HorizontalAlignment="Right"
                                FontSize="11.5" Cursor="Hand" Foreground="#2F6FED"
                                Background="Transparent" BorderThickness="0" Padding="4,0" />
                    </Grid>
                    <TextBox x:Name="OutputBox" BorderThickness="0" Background="Transparent" IsReadOnly="True"
                             TextWrapping="Wrap" FontSize="14" Foreground="#17203D" MaxHeight="190"
                             VerticalScrollBarVisibility="Auto" SelectionBrush="#2F6FED" />
                </StackPanel>
            </Border>

            <!-- 底部：方向切换 / 清空 + 状态 -->
            <Grid Margin="2,9,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DirectionButton" Content="自动" Click="OnDirectionClick" FontSize="11.5" Cursor="Hand"
                            Foreground="#7A849B" Background="Transparent" BorderThickness="0" Padding="0"
                            ToolTip="点击切换翻译方向（自动 / 中→英 / 英→中）" />
                    <TextBlock x:Name="DotSeparator" Text="·" FontSize="11.5" Foreground="#C9CFDC" Margin="6,0" VerticalAlignment="Center" />
                    <Button x:Name="ClearButton" Content="清空" Click="OnClearClick" FontSize="11.5" Cursor="Hand"
                            Foreground="#7A849B" Background="Transparent" BorderThickness="0" Padding="0"
                            ToolTip="清空原文与译文" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#9AA4B8"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="260" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
