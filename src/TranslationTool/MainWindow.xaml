<Window x:Class="TranslationTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线翻译 · Offline Translator"
        Height="680" Width="960" MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F9"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#17203D" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7A849B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FE" />
        <SolidColorBrush x:Key="DividerBrush" Color="#E6EAF3" />

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="2" Direction="270" Opacity="0.07" Color="#0B1B3A" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="9" Background="Transparent" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F1F4FA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2159C9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B4AAB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F4FA" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="SpellCheck.IsEnabled" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="28,22,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="离线翻译" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                            Margin="10,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="本地 ONNX 推理" FontSize="11.5" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="中 ⇄ 英 · 无需联网 · 文本不离开本机" FontSize="12.5" Margin="1,6,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="20" Padding="14,7" VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#C9CFDC" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="初始化中" FontSize="12.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <Button x:Name="MiniModeButton" Content="迷你模式" Click="OnMiniModeClick"
                        Style="{StaticResource GhostButton}" Padding="12,6" VerticalAlignment="Center"
                        ToolTip="切换到置顶迷你小窗" />

                <Button x:Name="SettingsButton" Content="⚙" Click="OnSettingsClick" FontSize="15"
                        Style="{StaticResource GhostButton}" Width="40" Height="34" Margin="8,0,0,0"
                        VerticalAlignment="Center" ToolTip="设置" />

                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="White" CornerRadius="12" Padding="16,12" Margin="0,6,10,0"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#0B1B3A" />
                        </Border.Effect>
                        <StackPanel MinWidth="220">
                            <TextBlock Text="设置" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8" />
                            <CheckBox x:Name="AutoStartCheck" Content="开机自动启动"
                                      FontSize="13" Cursor="Hand"
                                      Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged" />
                            <CheckBox x:Name="MinimizeTrayCheck" Content="最小化到系统托盘"
                                      FontSize="13" Cursor="Hand" Margin="0,8,0,0"
                                      Checked="OnMinimizeTrayChanged" Unchecked="OnMinimizeTrayChanged" />
                            <CheckBox x:Name="AutoClearCheck" Content="翻译后自动清空文本"
                                      FontSize="13" Cursor="Hand" Margin="0,8,0,0"
                                      Checked="OnAutoClearChanged" Unchecked="OnAutoClearChanged" />
                            <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
                                <TextBlock Text="翻译后" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="AutoClearIntervalCombo" Width="90" Margin="8,0" FontSize="12"
                                          VerticalAlignment="Center" IsEnabled="False"
                                          SelectionChanged="OnAutoClearIntervalChanged">
                                    <ComboBoxItem Content="30 秒" Tag="30" />
                                    <ComboBoxItem Content="1 分钟" Tag="60" />
                                    <ComboBoxItem Content="5 分钟" Tag="300" />
                                    <ComboBoxItem Content="10 分钟" Tag="600" />
                                    <ComboBoxItem Content="30 分钟" Tag="1800" />
                                </ComboBox>
                                <TextBlock Text="内容未变则自动清空" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="开启后，最小化窗口时将隐藏到托盘" FontSize="10.5"
                                       Foreground="#A8B0C2" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <!-- 方向选择 -->
        <Border Grid.Row="1" Margin="28,18,28,0" Style="{StaticResource CardBorder}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="翻译方向" FontSize="12.5" Margin="8,0,12,0" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <RadioButton x:Name="DirectionAuto" Content="自动识别" IsChecked="True"
                                 Style="{StaticResource SegmentRadio}" Checked="OnDirectionChanged" />
                    <RadioButton x:Name="DirectionZhEn" Content="中 → 英"
                                 Style="{StaticResource SegmentRadio}" Checked="OnDirectionChanged" />
                    <RadioButton x:Name="DirectionEnZh" Content="英 → 中"
                                 Style="{StaticResource SegmentRadio}" Checked="OnDirectionChanged" />
                </StackPanel>

                <Button Grid.Column="2" x:Name="SwapButton" Content="⇄ 换向" Click="OnSwapClick"
                        Style="{StaticResource GhostButton}" Padding="14,6" VerticalAlignment="Center"
                        ToolTip="切换中英翻译方向" />
            </Grid>
        </Border>

        <!-- 编辑器区域 -->
        <Grid Grid.Row="2" Margin="28,16,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="原文" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="CharCountText" Text="0 字" FontSize="11.5" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button x:Name="ClearButton" Content="清空" Click="OnClearClick"
                                    Style="{StaticResource TextLinkButton}" ToolTip="清空原文与译文" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <TextBox x:Name="InputBox" Style="{StaticResource EditorBox}"
                                 TextChanged="OnInputTextChanged" />
                        <TextBlock x:Name="Placeholder" Text="输入或粘贴要翻译的文本…（Ctrl+Enter 翻译）"
                                   FontSize="15.5" Foreground="#A8B0C2" TextWrapping="Wrap"
                                   IsHitTestVisible="False" Margin="2,2,0,0" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="译文" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <Button x:Name="CopyButton" Content="复制" Click="OnCopyClick" HorizontalAlignment="Right"
                                Style="{StaticResource TextLinkButton}" ToolTip="复制译文到剪贴板" />
                    </Grid>

                    <Grid>
                        <TextBox x:Name="OutputBox" Style="{StaticResource EditorBox}" IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True" />
                        <TextBlock x:Name="OutputPlaceholder" Text="译文会显示在这里"
                                   FontSize="15.5" Foreground="#A8B0C2" TextWrapping="Wrap"
                                   IsHitTestVisible="False" Margin="2,2,0,0" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="3" Margin="28,16,28,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" x:Name="AutoTranslateCheck" Content="自动翻译"
                      FontSize="12.5" VerticalAlignment="Center"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      Checked="OnAutoTranslateChanged" Unchecked="OnAutoTranslateChanged" />

            <StackPanel Grid.Column="1" Margin="24,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusDetail" Text="准备就绪" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="DownloadProgressBar" Height="4" Margin="0,7,0,0" Maximum="100"
                             Visibility="Collapsed" BorderThickness="0"
                             Foreground="{StaticResource AccentBrush}" Background="#E7ECF6" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DownloadButton" Content="下载模型" Click="OnDownloadClick"
                        Style="{StaticResource GhostButton}" Padding="16,0" Height="42" Margin="0,0,10,0"
                        ToolTip="从 HuggingFace 下载离线模型（约 190 MB）" />
                <Button x:Name="TranslateButton" Content="翻译" Click="OnTranslateClick"
                        Style="{StaticResource PrimaryButton}" Width="132" Height="42" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
